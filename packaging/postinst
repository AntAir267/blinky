#!/bin/sh
set -e

case "$1" in
    configure)
        # udev only applies rules when a device appears, so reload and retrigger
        # in case the camera is already plugged in.
        if [ -d /run/udev ] && command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules >/dev/null 2>&1 || true
            udevadm trigger --subsystem-match=usb --attr-match=idVendor=0c77 \
                >/dev/null 2>&1 || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
